{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // Mesmo critério do antigo `npm audit --omit=dev --audit-level=high`.
  "high": true,
  "skip-dev": true,
  "allowlist": [
    // picomatch <=4.0.7 (ReDoS em extglobs), via @mastra/core. Sem versão corrigida
