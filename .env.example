# Postgres.
DATABASE_URL=postgres://ritu:ritu@localhost:5432/ritu
# Chave do projeto de desenvolvimento; só os comandos ⚠️ a usam.
GEMINI_API_KEY=
# Sessão.
AUTH_SECRET=
# HMAC do IP nos limites.
IP_HMAC_SECRET=
# Autenticação do cron.
CRON_SECRET=
# Login Google; sem ela a Entrada mostra só a demonstração.
AUTH_GOOGLE_ID=
# Login Google; sem ela a Entrada mostra só a demonstração.
AUTH_GOOGLE_SECRET=
# Contas com limite ampliado.
TESTER_IDS=
# Sem ela a telemetria fica desligada. Dev: http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Token do Grafana Cloud.
OTEL_EXPORTER_OTLP_HEADERS=
# Padrão ritu.
OTEL_SERVICE_NAME=ritu
