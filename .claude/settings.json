{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout --:*)",
      "Bash(git tag:*)",
      "Bash(git push)",
      "Bash(git push --tags)",
      "Bash(git push origin main)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(docker compose:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)",
      "Bash(git clean -f --:*)",
      "Bash(gh run watch:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add -u:*)",
      "Bash(git add .)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fx:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rm -r:*)",
      "Bash(rm -fr:*)"
    ]
  }
}
