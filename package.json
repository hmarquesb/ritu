{
  "name": "ritu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:det": "vitest run --config vitest.eval.config.ts",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "dup": "jscpd",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/cleanup.ts",
    "padroes": "node --env-file-if-exists=.env.local --import tsx scripts/padroes.ts",
    "cotas": "node --env-file-if-exists=.env.local --import tsx scripts/cotas.ts",
    "modelos:check": "node --env-file-if-exists=.env.local --import tsx scripts/modelos-check.ts",
    "env:check": "node --env-file-if-exists=.env.local --import tsx scripts/env-check.ts",
    "base:check": "tsx scripts/base-check.ts",
    "clima:real": "tsx scripts/clima-real.ts",
    "runtime:real": "node --env-file-if-exists=.env.local --import tsx scripts/runtime-real.ts",
    "loop:demo": "node --env-file-if-exists=.env.local --import tsx scripts/loop-demo.ts",
    "eval:llm": "node --env-file-if-exists=.env.local --import tsx scripts/eval-llm.ts",
    "demo": "node --env-file-if-exists=.env.local --import tsx scripts/demo.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@mastra/core": "^1.83.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.2",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-node": "^0.223.2",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/otel": "^2.3.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.7",
    "@opentelemetry/context-async-hooks": "^2.12.1",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jscpd": "^5.4.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
