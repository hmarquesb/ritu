# Postgres. Em produção, a URL do Neon com pooler
DATABASE_URL=postgres://ritu:ritu@localhost:5432/ritu
# Em produção, a chave do projeto de produção
GEMINI_API_KEY=
# Chave de outro projeto do Google, só para os evals com LLM
GEMINI_API_KEY_2=
# Chave de outro projeto do Google, só para os evals com LLM
GEMINI_API_KEY_3=
# Sessão.
AUTH_SECRET=
# HMAC do IP nos limites.
IP_HMAC_SECRET=
# Autenticação do cron.
CRON_SECRET=
# Login Google; sem ela a Entrada mostra só a demonstração.
AUTH_GOOGLE_ID=
# Login Google; sem ela a Entrada mostra só a demonstração.
AUTH_GOOGLE_SECRET=
# e2e: stores em memória para o Playwright. Recusada em produção.
RITU_MODO=
# E-mails do Google, separados por vírgula, sem limite de uso.
TESTER_IDS=
# Em produção, endpoint e token do Grafana Cloud.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Em produção, endpoint e token do Grafana Cloud.
OTEL_EXPORTER_OTLP_HEADERS=
# Padrão ritu.
OTEL_SERVICE_NAME=ritu
# Sha do commit, posto pela CI em cada deploy.
RITU_VERSAO=
# Para `env:producao` à mão.
VERCEL_TOKEN=
# Para `env:producao` à mão.
VERCEL_ORG_ID=
# Para `env:producao` à mão.
VERCEL_PROJECT_ID=
# Para `painel:publicar`.
GRAFANA_URL=
# Para `painel:publicar`.
GRAFANA_TOKEN=
# Para `painel:publicar`.
GRAFANA_ALERTA_EMAIL=
# URL de produção, para `smoke` e `smoke:completo`.
SITE_URL=
